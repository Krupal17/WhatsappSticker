<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".toolkit.ToolActivity">

    <Button
        android:id="@+id/btnWhatsappStickerDemo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Whatsapp Sticker Demo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnInAppHotspotDemo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="In App Hotspot On_Off Demo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnWhatsappStickerDemo" />


    <Button
        android:id="@+id/btnStatementScanDemo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Statement Scanner Demo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnInAppHotspotDemo" />

</androidx.constraintlayout.widget.ConstraintLayout>